# Telegram Bot Token от BotFather
BOT_TOKEN = your_telegram_bot_token

# App ID от OpenExchangeRates (для курсов валют)
EXCHANGE_APP_ID = your_openexchangerates_app_id

# Строка подключения к MongoDB
MONGO_URI = mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Название базы данных
MONGO_DB_NAME = test

# Ключ шифрования AES-256-CBC (ровно 32 символа)
ENCRYPTION_KEY = your_32_character_key_here

# API-ключ Groq
GROQ_API_KEY = your_groq_api_key

# Модель Groq (например openai/gpt-oss-20b, llama-3.3-70b-versatile)
GROQ_MODEL = openai/gpt-oss-20b

# Порт для Fastify-сервера
PORT = 3000

# Публичный URL Mini App (например ngrok в dev, домен на проде)
APP_URL = https://your-ngrok-url.ngrok-free.dev

# Короткое имя Mini App (из BotFather -> Bot Settings -> Menu Button)
APP_SHORTNAME = app
